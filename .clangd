# clangd configuration for freerouting C++20 migration
CompileFlags:
  Add: 
    - -std=c++20
    - -Wall
    - -Wextra
    - -Werror
    - -Wpedantic
    - -Wno-unused-parameter
    - -Wno-missing-field-initializers
    - -Wno-c99-extensions
    - -I${workspaceFolder}/include
    - -I${workspaceFolder}/src

Diagnostics:
  UnusedIncludes: Strict
  ClangTidy:
    Add: 
      - modernize-*
      - readability-*
      - performance-*
      - bugprone-*
      - concurrency-*
      - cppcoreguidelines-*
    Remove:
      - modernize-use-trailing-return-type
      - readability-identifier-length
  Suppress:
    - modernize-use-auto
    - readability-magic-numbers  # Allow magic numbers in geometry

Index:
  Background: true
  Standard: C++20

Style:
  FullyQualifiedNamespaces: false
  IncompleteTypes: true
