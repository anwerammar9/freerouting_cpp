+Item* find_first_obstacle(const ShoveTraceAlgo* p_this,
+                          const Polyline& p_polyline,
+                          int p_half_width,
+                          int p_layer,
+                          const std::vector<int>& p_net_no_arr,
+                          int p_cl_type,
+                          bool p_over_connected_pins,
+                          const std::set<Pin*>* p_contact_pins,
+                          IntBox* p_out_obstacle_bbox)
+{
+    auto* search_tree = p_this->board_->get_search_tree_manager()->get_default_tree();
+    std::vector<int> check_net_no_arr;
+    if (p_contact_pins == nullptr)
+    {
+        check_net_no_arr = p_net_no_arr;
+    }
+    for (size_t i = 1; i + 1 < p_polyline.arr.size(); ++i)
+    {
+        TileShape* current_shape = p_polyline.offset_shape(p_half_width, static_cast<int>(i));
+        if (!current_shape)
+        {
+            continue;
+        }
+        std::vector<Item*> obstacles = search_tree->overlapping_items_with_clearance(
+            *current_shape, p_layer, check_net_no_arr, p_cl_type);
+        for (Item* current_item : obstacles)
+        {
+            bool is_obstacle = false;
+            if (current_item->shares_net_no(p_net_no_arr))
+            {
+                if (auto* pin = dynamic_cast<Pin*>(current_item))
+                {
+                    is_obstacle = (p_contact_pins != nullptr && p_contact_pins->find(pin) == p_contact_pins->end());
+                }
+            }
+            else if (auto* conduction = dynamic_cast<ConductionArea*>(current_item))
+            {
+                is_obstacle = conduction->get_is_obstacle();
+            }
+            else if (dynamic_cast<ViaObstacleArea*>(current_item) || dynamic_cast<ComponentObstacleArea*>(current_item))
+            {
+                is_obstacle = false;
+            }
+            else if (auto* trace = dynamic_cast<PolylineTrace*>(current_item))
+            {
+                if (trace->is_shove_fixed())
+                {
+                    is_obstacle = true;
+                    for (Item* contact : trace->get_normal_contacts())
+                    {
+                        if (contact->shares_net_no(p_net_no_arr))
+                        {
+                            is_obstacle = false;
+                            break;
+                        }
+                    }
+                }
+                else
+                {
+                    is_obstacle = false;
+                }
+            }
+            else
+            {
+                is_obstacle = !current_item->is_routable();
+            }
+
+            if (is_obstacle)
+            {
+                if (p_out_obstacle_bbox)
+                {
+                    *p_out_obstacle_bbox = current_item->bounding_box();
+                }
+                return current_item;
+            }
+        }
+    }
+    return nullptr;
+}
+
+std::unique_ptr<TileShape> get_obstacle_shape(Item* p_obstacle,
+                                              ShapeSearchTree* p_search_tree,
+                                              int p_layer)
+{
+    if (auto* obstacle_area = dynamic_cast<ObstacleArea*>(p_obstacle))
+    {
+        if (obstacle_area->tree_shape_count(*p_search_tree) == 1)
+        {
+            return std::unique_ptr<TileShape>(obstacle_area->get_tree_shape(*p_search_tree, 0)->clone());
+        }
+    }
+    else if (auto* trace = dynamic_cast<PolylineTrace*>(p_obstacle))
+    {
+        if (trace->tree_shape_count(*p_search_tree) == 1)
+        {
+            return std::unique_ptr<TileShape>(trace->get_tree_shape(*p_search_tree, 0)->clone());
+        }
+    }
+    else if (auto* drill_item = dynamic_cast<DrillItem*>(p_obstacle))
+    {
+        return std::unique_ptr<TileShape>(drill_item->get_tree_shape_on_layer(p_search_tree, p_layer)->clone());
+    }
+    return nullptr;
+}
+
+bool try_spring_over_obstacle(const ShoveTraceAlgo* p_this,
+                              Polyline& p_polyline,
+                              int p_half_width,
+                              int p_layer,
+                              const std::vector<int>& p_net_no_arr,
+                              int p_cl_type,
+                              bool p_over_connected_pins,
+                              int p_recursion_depth,
+                              const std::set<Pin*>* p_contact_pins,
+                              Item* p_obstacle)
+{
+    auto* search_tree = p_this->board_->get_search_tree_manager()->get_default_tree();
+    if (!p_over_connected_pins)
+    {
+        std::vector<Item*> contacts_on_layer = p_obstacle->get_all_contacts(p_layer);
+        for (Item* contact : contacts_on_layer)
+        {
+            if (dynamic_cast<Trace*>(contact))
+            {
+                return false;
+            }
+        }
+    }
+
+    auto obstacle_shape = get_obstacle_shape(p_obstacle, search_tree, p_layer);
+    if (!obstacle_shape)
+    {
+        return false;
+    }
+
+    int offset = p_half_width + 1;
+    std::unique_ptr<TileShape> offset_shape;
+    if (search_tree->is_clearance_compensation_used())
+    {
+        offset_shape = obstacle_shape->offset(offset);
+    }
+    else
+    {
+        double half_cl_offset = 0.5 * p_this->board_->clearance_value(
+            p_obstacle->get_clearance_class(), p_cl_type, p_layer);
+        offset_shape = obstacle_shape->offset(offset + half_cl_offset);
+        offset_shape = offset_shape->offset(half_cl_offset);
+    }
+
+    const BoardRules& rules = p_this->board_->get_rules();
+    if (rules.get_trace_angle_restriction() == AngleRestriction::NINETY_DEGREE)
+    {
+        if (auto* box = dynamic_cast<IntBox*>(offset_shape.get()))
+        {
+            // already a box
+        }
+        else
+        {
+            offset_shape = std::make_unique<IntBox>(offset_shape->bounding_box());
+        }
+    }
+    else if (rules.get_trace_angle_restriction() == AngleRestriction::FORTY_FIVE_DEGREE)
+    {
+        if (auto* oct = dynamic_cast<IntOctagon*>(offset_shape.get()))
+        {
+            // already an octagon
+        }
+        else
+        {
+            offset_shape = std::make_unique<IntOctagon>(offset_shape->bounding_octagon());
+        }
+    }
+
+    if (offset_shape->contains_inside(p_polyline.first_corner()) ||
+        offset_shape->contains_inside(p_polyline.last_corner()))
+    {
+        return false;
+    }
+
+    std::vector<std::pair<int, int>> entries = offset_shape->entrance_points(p_polyline);
+    if (entries.empty())
+    {
+        return true; // no obstacle
+    }
+    if (entries.size() < 2)
+    {
+        return false;
+    }
+
+    int first_intersection_side_no = entries[0].second;
+    int last_intersection_side_no = entries.back().second;
+    int first_intersection_line_no = entries[0].first;
+    int last_intersection_line_no = entries.back().first;
+    int side_diff = last_intersection_side_no - first_intersection_side_no;
+    if (side_diff < 0)
+    {
+        side_diff += offset_shape->border_line_count();
+    }
+    else if (side_diff == 0)
+    {
+        FloatPoint compare_corner = offset_shape->corner_approx(first_intersection_side_no);
+        FloatPoint first_intersection = p_polyline.arr[first_intersection_line_no].intersection_approx(
+            offset_shape->border_line(first_intersection_side_no));
+        FloatPoint second_intersection = p_polyline.arr[last_intersection_line_no].intersection_approx(
+            offset_shape->border_line(last_intersection_side_no));
+        if (compare_corner.distance(second_intersection) < compare_corner.distance(first_intersection))
+        {
+            side_diff += offset_shape->border_line_count();
+        }
+    }
+
+    std::vector<Line> substitute_lines;
+    substitute_lines.reserve(side_diff + 3);
+    substitute_lines.push_back(p_polyline.arr[first_intersection_line_no]);
+    int current_edge_line_no = first_intersection_side_no;
+    for (int i = 1; i <= side_diff + 1; ++i)
+    {
+        substitute_lines.push_back(offset_shape->border_line(current_edge_line_no));
+        if (current_edge_line_no == offset_shape->border_line_count() - 1)
+        {
+            current_edge_line_no = 0;
+        }
+        else
+        {
+            ++current_edge_line_no;
+        }
+    }
+    substitute_lines.push_back(p_polyline.arr[last_intersection_line_no]);
+    Polyline substitute_polyline(substitute_lines);
+
+    std::vector<std::unique_ptr<Polyline>> pieces = offset_shape->cutout(p_polyline);
+    Polyline result = substitute_polyline;
+
+    if (!pieces.empty())
+    {
+        result = pieces[0]->combine(substitute_polyline);
+    }
+    if (pieces.size() > 1)
+    {
+        result = result.combine(*pieces[1]);
+    }
+
+    p_polyline = std::move(result);
+    return true;
+}
