+std::vector<std::unique_ptr<Polyline>> TileShape::cutout(const Polyline& p_polyline) const
+{
+    std::vector<std::pair<int, int>> intersection_no = entrance_points(p_polyline);
+    const IntPoint first_corner = p_polyline.first_corner();
+    const bool first_corner_is_inside = contains_inside(first_corner);
+
+    std::vector<std::unique_ptr<Polyline>> pieces;
+
+    if (intersection_no.empty())
+    {
+        if (first_corner_is_inside)
+        {
+            return {};
+        }
+        pieces.emplace_back(std::make_unique<Polyline>(p_polyline));
+        return pieces;
+    }
+
+    size_t current_intersection_no = 0;
+    const auto& current_intersection_tuple = intersection_no[current_intersection_no];
+    std::unique_ptr<Point> first_intersection =
+        p_polyline.arr[current_intersection_tuple.first].intersection(border_line(current_intersection_tuple.second));
+
+    if (!first_corner_is_inside)
+    {
+        if (!first_corner.equals(first_intersection.get()))
+        {
+            int current_polyline_intersection_no = current_intersection_tuple.first;
+            std::vector<Line> current_lines;
+            current_lines.reserve(current_polyline_intersection_no + 2);
+            for (int i = 0; i <= current_polyline_intersection_no; ++i)
+            {
+                current_lines.push_back(p_polyline.arr[i]);
+            }
+            current_lines.push_back(border_line(current_intersection_tuple.second));
+            Polyline current_piece(current_lines);
+            if (!current_piece.arr.empty())
+            {
+                pieces.emplace_back(std::make_unique<Polyline>(std::move(current_piece)));
+            }
+        }
+        ++current_intersection_no;
+    }
+
+    while (current_intersection_no + 1 < intersection_no.size())
+    {
+        const auto& curr_tuple = intersection_no[current_intersection_no];
+        const auto& next_tuple = intersection_no[current_intersection_no + 1];
+        int current_intersection_no_of_polyline = curr_tuple.first;
+        int next_intersection_no_of_polyline = next_tuple.first;
+
+        bool insert_piece = false;
+        for (int i = current_intersection_no_of_polyline + 1; i < next_intersection_no_of_polyline; ++i)
+        {
+            if (is_outside(p_polyline.corner(i)))
+            {
+                insert_piece = true;
+                break;
+            }
+        }
+
+        if (insert_piece)
+        {
+            std::vector<Line> current_lines;
+            current_lines.reserve(next_intersection_no_of_polyline - current_intersection_no_of_polyline + 3);
+            current_lines.push_back(border_line(curr_tuple.second));
+            for (int i = current_intersection_no_of_polyline; i <= next_intersection_no_of_polyline; ++i)
+            {
+                current_lines.push_back(p_polyline.arr[i]);
+            }
+            current_lines.push_back(border_line(next_tuple.second));
+            Polyline current_piece(current_lines);
+            if (!current_piece.arr.empty())
+            {
+                pieces.emplace_back(std::make_unique<Polyline>(std::move(current_piece)));
+            }
+        }
+        current_intersection_no += 2;
+    }
+
+    if (current_intersection_no < intersection_no.size())
+    {
+        const auto& current_tuple = intersection_no[current_intersection_no];
+        int current_polyline_intersection_no = current_tuple.first;
+        std::vector<Line> current_lines;
+        current_lines.reserve(p_polyline.arr.size() - current_polyline_intersection_no + 1);
+        current_lines.push_back(border_line(current_tuple.second));
+        for (size_t i = current_polyline_intersection_no; i < p_polyline.arr.size(); ++i)
+        {
+            current_lines.push_back(p_polyline.arr[i]);
+        }
+        Polyline current_piece(current_lines);
+        if (!current_piece.arr.empty())
+        {
+            pieces.emplace_back(std::make_unique<Polyline>(std::move(current_piece)));
+        }
+    }
+
+    return pieces;
+}
