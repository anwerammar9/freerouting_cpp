    if (intersectionNo.length == 0) {
      // no intersections
      if (firstCornerIsInside) {
        // polyline is contained completely in this shape
        return new Polyline[0];
      }
      // polyline is completely outside
      Polyline[] result = new Polyline[1];
      result[0] = polyline;
