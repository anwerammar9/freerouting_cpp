    {
        items_.push_back(p_item);
    }
}

void RoutingBoard::remove_item(Item* p_item)
{
    if (!p_item)
        return;
        
    auto it = std::find(items_.begin(), items_.end(), p_item);
    if (it != items_.end())
    {
        items_.erase(it);
    }
}

