#ifndef AUTOROUTE_INSERT_FOUND_CONNECTION_ALGO_H
#define AUTOROUTE_INSERT_FOUND_CONNECTION_ALGO_H

#include <memory>
#include <vector>

#include "board/Item.h"
#include "board/FixedState.h"
#include "autoroute/AutorouteControl.h"
#include "autoroute/LocateFoundConnectionAlgo.h"

namespace freerouting::board {
class RoutingBoard;
}

namespace freerouting::autoroute {

class InsertFoundConnectionAlgo
{
public:
    static bool insert(std::unique_ptr<LocateResult> p_connection,
                      board::RoutingBoard* p_board,
                      const AutorouteControl& p_ctrl);

private:
    InsertFoundConnectionAlgo(board::RoutingBoard* p_board, const AutorouteControl& p_ctrl);

    bool insert_via(int p_from_layer, int p_to_layer);
    bool insert_trace(LocateResultItem& p_trace);

    board::RoutingBoard* board_ = nullptr;
    const AutorouteControl* ctrl_ = nullptr;
    int last_x_ = 0;
    int last_y_ = 0;
    int first_x_ = 0;
    int first_y_ = 0;
};

} // namespace freerouting::autoroute

#endif // AUTOROUTE_INSERT_FOUND_CONNECTION_ALGO_H#include "autoroute/InsertFoundConnectionAlgo.h"
#include "autoroute/LocateFoundConnectionAlgo.h"
#include "board/RoutingBoard.h"
#include "logger/FRLogger.h"

#include <vector>

namespace freerouting::autoroute {

InsertFoundConnectionAlgo::InsertFoundConnectionAlgo(board::RoutingBoard* p_board, const AutorouteControl& p_ctrl)
    : board_(p_board), ctrl_(&p_ctrl)
{
}

bool InsertFoundConnectionAlgo::insert_via(int p_from_layer, int p_to_layer)
{
    (void)p_from_layer;
    (void)p_to_layer;
    return true;
}

bool InsertFoundConnectionAlgo::insert_trace(LocateResultItem& p_trace)
{
    (void)p_trace;
    return true;
}

bool InsertFoundConnectionAlgo::insert(std::unique_ptr<LocateResult> p_connection,
                                   board::RoutingBoard* p_board,
                                   const AutorouteControl& p_ctrl)
{
    (void)p_board;
    (void)p_ctrl;

    if (!p_connection || p_connection->connection_items.empty())
    {
        freerouting::logger::FRLogger::instance().warn("InsertFoundConnectionAlgo: no connection to insert");
        return false;
    }

    InsertFoundConnectionAlgo inserter(p_board, p_ctrl);

    for (auto& trace_item : p_connection->connection_items)
    {
        if (!inserter.insert_trace(trace_item))
        {
            freerouting::logger::FRLogger::instance().warn("InsertFoundConnectionAlgo: failed to insert trace");
            return false;
        }
    }

    return true;
}

} // namespace freerouting::autoroute#ifndef AUTOROUTE_LOCATE_FOUND_CONNECTION_ALGO_H
#define AUTOROUTE_LOCATE_FOUND_CONNECTION_ALGO_H

#include <vector>
#include <memory>

#include "autoroute/MazeSearchAlgo.h"
#include "autoroute/AutorouteControl.h"
#include "geometry/planar/Point.h"
#include "board/Item.h"

namespace freerouting::board {
class ShapeSearchTree;
}

namespace freerouting::autoroute {

struct LocateResultItem
{
    int layer = 0;
    int section_no = 0;
};

struct LocateResult
{
    std::vector<LocateResultItem> connection_items;
    board::Item* start_item = nullptr;
    int start_layer = 0;
    board::Item* target_item = nullptr;
    int target_layer = 0;
    bool success = false;
};

class LocateFoundConnectionAlgo
{
public:
    static std::unique_ptr<LocateResult> locate(MazeSearchAlgo::Result p_maze_result,
                                        const AutorouteControl& p_ctrl,
                                        board::ShapeSearchTree* p_search_tree,
                                        const std::vector<board::Item*>& p_ripped_items);

protected:
    LocateFoundConnectionAlgo(MazeSearchAlgo::Result p_maze_result,
                               const AutorouteControl& p_ctrl,
                               board::ShapeSearchTree* p_search_tree);

    AutorouteControl ctrl_;
    board::ShapeSearchTree* search_tree_ = nullptr;
    std::vector<LocateResultItem> connection_items_;
    board::Item* start_item_ = nullptr;
    int start_layer_ = 0;
    board::Item* target_item_ = nullptr;
    int target_layer_ = 0;

    std::vector<geometry::planar::FloatPoint> backtrack_points_;
    int current_from_index_ = 0;
    int current_to_index_ = 0;

    bool init_backtrack(const MazeSearchAlgo::Result& p_maze_result);
    LocateResultItem calculate_next_trace(bool p_layer_changed);
};

} // namespace freerouting::autoroute

#endif // AUTOROUTE_LOCATE_FOUND_CONNECTION_ALGO_H
